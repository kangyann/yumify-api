// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Products {
  id                   Int                   @id @default(autoincrement())
  productName          String                @unique @db.VarChar(32)
  productImage         String                @db.Text
  productPrice         Int                   @db.Integer
  productType          String                @db.VarChar(16)
  createdAt            DateTime              @default(now())
  productsTransactions ProductsTransaction[]
}

model Payments {
  id           Int            @id @default(autoincrement())
  paymentName  String         @db.VarChar(16)
  paymentCode  String         @unique @db.VarChar(6)
  status       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  transactions Transactions[]
}

model ProductsTransaction {
  id              Int          @id @default(autoincrement())
  productId       Products     @relation(fields: [productsId], references: [id])
  productsId      Int
  productQuantity Int          @db.Integer
  totalPrice      Int          @db.Integer
  transactionId   Transactions @relation(fields: [transactionsId], references: [id])
  transactionsId  Int
}

model Transactions {
  id                   Int                   @id @default(autoincrement())
  invoiceNumber        String                @unique @db.VarChar(16)
  paymentString        String                @db.Text
  paymentId            Payments              @relation(fields: [paymentsId], references: [id])
  paymentsId           Int
  totalPrice           Int                   @db.Integer
  status               String                @db.VarChar(16)
  createdAt            DateTime              @default(now())
  expireAt             DateTime?
  productsTransactions ProductsTransaction[]
}
